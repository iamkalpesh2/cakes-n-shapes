# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Use the Secret key from Supabase API Keys, if your project has one.
SUPABASE_SECRET_KEY=your-secret-key
# If your dashboard only shows Legacy API Keys, use service_role instead.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Keep SUPABASE_SECRET_KEY/SUPABASE_SERVICE_ROLE_KEY server-only. Never expose them in client components.
